# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
POSTGRES_USER=bonici
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bonici
# Used by the app. Inside Docker the host is "db"; for `npm run dev` on your machine use localhost.
DATABASE_URL=postgresql://bonici:change-me@localhost:5433/bonici

# --- Site -----------------------------------------------------------------
# Public URL, used in password-reset emails and order-tracking links.
SITE_URL=http://localhost:3000
# Domain Caddy requests an HTTPS certificate for (production profile only).
DOMAIN=bonici.africa
# Where uploaded files (photos, CVs, documents) are stored.
UPLOAD_DIR=./uploads

# --- First admin account (created by the seed if no admin exists) --------
ADMIN_EMAIL=admin@bonici.africa
ADMIN_PASSWORD=change-me-too

# --- Email (password reset). Leave SMTP_HOST empty to print emails to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bonici <no-reply@bonici.africa>"

# --- Odoo (optional). Leave ODOO_URL empty to disable the integration. ---
# Website orders are pushed to Odoo as sales orders (sale.order).
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
# An API key (Odoo: Preferences > Account Security > New API Key) or the password.
ODOO_API_KEY=
# Product used for dishes that have no Odoo product mapped yet, and for the delivery fee.
ODOO_FALLBACK_PRODUCT_ID=
ODOO_DELIVERY_PRODUCT_ID=
# Confirm the sales order in Odoo right away (true) or leave it as a quotation (false).
ODOO_CONFIRM_ORDERS=true
# Site prices include tax. Leave empty (no tax added by Odoo), or list the ids of Odoo taxes
# configured as "included in price" (e.g. TVA 18 % TTC) so VAT is reported without changing totals.
ODOO_LINE_TAX_IDS=
